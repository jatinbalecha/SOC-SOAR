    },
    {
      "parameters": {
        "jsCode": "const id = $('Read Intake').first().json.query.id;\nconst rows = $input.all().map((i) => i.json).filter((r) => r.ts && (!id || r.case_id === id)).sort((a, b) => String(a.ts).localeCompare(String(b.ts)));\nreturn [{ json: { audit: rows.map(({ id, createdAt, updatedAt, ...rest }) => rest) } }];"
      },
      "name": "Shape Audit",
      "type": "n8n-nodes-base.code",
